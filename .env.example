TELEGRAM_BOT_TOKEN=replace-me
LLM_API_KEY=replace-me
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
MEMORY_LIMIT=10

# JSON: Telegram user_id -> profile name.
USER_PROFILES={"123456789":"OWNER","222222222":"IGNORE","333333333":"DINESH_DEBT","444444444":"DINESH_DOMESTIC"}

# IGNORE can either stay silent or send the configured phrase.
IGNORE_SILENT=false
IGNORE_REPLY=Сообщение принято.

# Optional JSON overrides. Omitted profiles retain built-in MVP prompts.
PROFILE_PROMPTS={}

# Stage 2: Telegram user-account listener. All IDs below are fake examples.
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=replace-me
TELEGRAM_SESSION_NAME=son-of-anton
OWNER_USER_ID=100000001
CLOSE_RELATIVE_IDS=[100000002,100000003]
DINESH_DOMESTIC_ID=100000004
DINESH_DEBT_ID=100000005
DINESH_DEBT_PAID=false
DINESH_DEBT_PAID_PROFILE=DEFAULT
BLOCKLIST_IDS=[100000006,100000007]
DRY_RUN=true
